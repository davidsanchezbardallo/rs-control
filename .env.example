# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a GitHub (ya está excluido en .gitignore).
# En local: los valores salen de `npx supabase status -o env`.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave publicable: puede estar en el navegador (RLS protege los datos)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clave SECRETA: solo servidor. Nunca en el navegador ni en GitHub.
SUPABASE_SECRET_KEY=

# --- Aplicación ---
APP_URL=http://localhost:3000
# Dominio técnico para convertir "usuario" en el email que exige Supabase Auth.
# No necesita buzón. ".invalid" es un dominio reservado que nunca recibe correo.
USERNAME_EMAIL_DOMAIN=usuarios.rscontrol.invalid

# --- Conexión bancaria (Enable Banking, opcional) ---
# Identificador de la aplicación creada en https://enablebanking.com/cp/applications
ENABLE_BANKING_APP_ID=
# Clave privada (.pem) descargada al crear la aplicación. SECRETA: solo en Vercel.
ENABLE_BANKING_PRIVATE_KEY=
# Secreto para la actualización automática diaria (Vercel lo envía a /api/banca/sync).
CRON_SECRET=
# Solo para pruebas con el banco simulado: http://127.0.0.1:4010
# ENABLE_BANKING_API_URL=https://api.enablebanking.com
