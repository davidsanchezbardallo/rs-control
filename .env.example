# Copia este archivo como .env.local y rellena los valores (Fase 3).
# NUNCA subas .env.local a GitHub (ya está excluido en .gitignore).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave publicable: puede estar en el navegador (RLS protege los datos)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clave SECRETA: solo servidor. Nunca en el navegador ni en GitHub.
SUPABASE_SECRET_KEY=

# --- Aplicación ---
APP_URL=http://localhost:3000
